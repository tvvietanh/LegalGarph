{"graph_record_id":"ontology:concept:employment_relationship","id":"evidence:e64ff8d9c2c90415a984de4332ec178aba9ef981ce5dea56423645e399bd5db0","literal_evidence":"VERIFIED","provenance":[{"literal_evidence":"VERIFIED","method":"curated_exact_source_quote","provision_char_end":287,"provision_char_start":0,"provision_node_id":"rule:provision:prov_2960b6a69467160b","quote":"5. Quan hệ lao động là quan hệ xã hội phát sinh trong việc thuê mướn, sử\ndụng lao động, trả lương giữa người lao động, người sử dụng lao động, các tổ\nchức đại diện của các bên, cơ quan nhà nước có thẩm quyền. Quan hệ lao động\nbao gồm quan hệ lao động cá nhân và quan hệ lao động tập thể.","quote_sha256":"57b78283f63e5a7c0c3505eddfe38b2988a78ab81422e10908790859ae753db3","rule_node_sha256":"80ed073216b4c6946d9fb764fecac3ce53e66191d7ea268e80eb0feafdbaae8c","source_ref":{"source_path":"02_processed_data/provisions.jsonl","source_record_id":"prov_2960b6a69467160b","source_record_sha256":"328dab308bc35de48b2c55c7b5064b59c07ada8404bb4489a5c42c25d5496765","source_sha256":"0b3d568a758998360f72be48bd1ff6fbefacf1995c6f774d6a17f63e5e262552"},"source_span":{"coordinate_space":"SEGMENT_TEXT","document_char_end":3667,"document_char_start":3380,"page_end":2,"page_start":2,"segment_char_end":2937,"segment_char_start":2650,"segment_id":"seg_4096206e891cc153"}}],"semantic":"VERIFIED"}
{"graph_record_id":"edge:fd1e31768dc81386f12657d6cdd05e765b166c2899b92393ab72efdb9203e523","id":"evidence:ebe1b1487e66805128c66b4169d3b2ed6367dc0755ef5c070ed4f139c6110115","literal_evidence":"VERIFIED","provenance":[{"literal_evidence":"VERIFIED","method":"curated_exact_source_quote","provision_char_end":453,"provision_char_start":0,"provision_node_id":"rule:provision:prov_e23d4776edabfdd8","quote":"3. Tổ chức đại diện người lao động tại cơ sở là tổ chức được thành lập trên\ncơ sở tự nguyện của người lao động tại một đơn vị sử dụng lao động nhằm mục\nđích bảo vệ quyền và lợi ích hợp pháp, chính đáng của người lao động trong quan\nhệ lao động thông qua thương lượng tập thể hoặc các hình thức khác theo quy\nđịnh của pháp luật về lao động. Tổ chức đại diện người lao động tại cơ sở bao\ngồm công đoàn cơ sở và tổ chức của người lao động tại doanh nghiệp.","quote_sha256":"1c20939e9bf3af047289b1be2f6c8ab7eb6c4e4c5d33b9d60bba61c9dc6d61be","rule_node_sha256":"7329141083fb05a83c00bfe7b01406ecdccc6d7dc2ae79e8872dd5257326c9db","source_ref":{"source_path":"02_processed_data/provisions.jsonl","source_record_id":"prov_e23d4776edabfdd8","source_record_sha256":"31b80e06c7fbb9ad9313e09c8f2a624915e473900f1dcb370bc7a3c08356424c","source_sha256":"0b3d568a758998360f72be48bd1ff6fbefacf1995c6f774d6a17f63e5e262552"},"source_span":{"coordinate_space":"SEGMENT_TEXT","document_char_end":3206,"document_char_start":2753,"page_end":2,"page_start":2,"segment_char_end":2476,"segment_char_start":2023,"segment_id":"seg_4096206e891cc153"}}],"semantic":"VERIFIED"}
